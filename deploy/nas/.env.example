# Copy to deploy/nas/.env on the NAS and fill in real values. DO NOT commit the real .env.
# Model values below are gateway caller configuration, not provider credentials.

# One reviewed absolute root for every persistent kg-hub data bind. This is the
# existing NAS target; change it explicitly here if this deployment uses another.
KG_HUB_DATA_ROOT=/volume2/4T/kg-hub-data

# FalkorDB auth (must match the value clients/server use).
FALKORDB_PASSWORD=replace-with-real-password

# Bearer token for the HTTP API (Authorization: Bearer <token> on every request).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
KG_HUB_API_TOKEN=replace-with-real-token

# NAS model-gateway caller token + logical business route. Populate the token
# with deploy/nas/configure-model-gateway-token.sh; never paste it into argv.
# The central client derives idempotency from a durable business operation ID.
# The actual provider, model and API key stay in the gateway registry/Vault.
KG_HUB_MODEL_GATEWAY_TOKEN=replace-with-independent-kg-hub-gateway-caller-token
ANTHROPIC_BASE_URL=http://model-gateway:39000
ANTHROPIC_MODEL=kg_hub.entity_extract

# Use docker-compose.yml together with deploy/model-gateway-network.override.yml
# and an operator-created external private network. Do not publish the gateway.
MODEL_GATEWAY_PRIVATE_NETWORK=model-gateway-private
