<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.claude-mem.capture-next</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>__CODE__/tools/claude_mem_isolated_launch.sh</string></array>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer>
<key>StandardOutPath</key><string>__HOME__/.claude-mem-next/launchd.out.log</string>
<key>StandardErrorPath</key><string>__HOME__/.claude-mem-next/launchd.err.log</string>
<key>ProcessType</key><string>Background</string>
</dict></plist>
