<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kg-hub.claude-mem-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__REPO__/tools/claude_mem_guard.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.kg-hub/logs/claude-mem-guard.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.kg-hub/logs/claude-mem-guard.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
