<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kg-hub.weekly-report</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/spike-graphiti/.venv/bin/python</string>
        <string>-m</string>
        <string>tools.weekly_report</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.kg-hub/logs/weekly-report.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.kg-hub/logs/weekly-report.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
