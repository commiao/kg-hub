<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>KG_HUB_FEISHU_WEBHOOK</key>
		<string>@KG_HUB_FEISHU_WEBHOOK@</string>
		<key>KG_HUB_URL</key>
		<string>http://100.123.208.32:17171</string>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.kg-hub.capsule-watch</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/spike-graphiti/.venv/bin/python</string>
		<string>-m</string>
		<string>tools.capsule_watch</string>
		<string>--feishu</string>
		<string>--only-on-change</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.kg-hub/logs/capsule-watch.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.kg-hub/logs/capsule-watch.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
</dict>
</plist>
