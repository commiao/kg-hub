{
  "description": "kg-hub PUSH hook for Codex CLI — auto-injects canonical content at SessionStart and UserPromptSubmit",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh /Users/mac/.local/share/kg-hub/current/tools/kg_push_hook.sh --format codex",
            "timeout": 10,
            "statusMessage": "Loading kg-hub canonical context"
          }
        ]
      }
    ]
  }
}
