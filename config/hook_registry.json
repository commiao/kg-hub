{
  "version": 1,
  "components": [
    {
      "id": "claude-mem",
      "label": "claude-mem",
      "patterns": ["worker-service.cjs", "claude-mem"],
      "purpose": "采集会话上下文、工具调用、文件编辑和会话总结，写入 claude-mem"
    },
    {
      "id": "kg-push",
      "label": "kg-hub PUSH",
      "patterns": ["kg_push_hook.py"],
      "purpose": "在会话开始或提交提示时注入 kg-hub canonical / 相关观察"
    },
    {
      "id": "task-hub",
      "label": "task-hub",
      "patterns": ["task-hub.py", "session_context.py", "heartbeat.py"],
      "purpose": "注入任务看板与登记协议，并用工具活动为当前任务续租"
    },
    {
      "id": "ops-context",
      "label": "运维上下文",
      "patterns": ["ops-hook-context.sh"],
      "purpose": "在会话开始时注入本机运维状态"
    },
    {
      "id": "hook-bridge",
      "label": "Hook Bridge",
      "patterns": ["dsh-hooks-claude-code", "dsh-hooks-codex"],
      "purpose": "复用 Claude Code / Codex shell hook"
    }
  ],
  "actions": {
    "start": "启动 worker",
    "version-check": "版本检查",
    "context": "注入历史",
    "session-init": "登记会话",
    "file-context": "读取前关联",
    "file-edit": "记录编辑",
    "observation": "记录调用",
    "summarize": "会话收尾",
    "session-context": "注入任务",
    "heartbeat": "任务续租",
    "push": "注入知识",
    "ops-context": "运维状态",
    "bridge": "兼容桥"
  },
  "tools": [
    {
      "id": "claude",
      "label": "Claude Code",
      "difference": "原生 Hook · 用户级 · 全链路",
      "sources": [
        {"kind": "json", "path": "~/.claude/settings.json", "scope": "用户"},
        {"kind": "latest_glob", "path": "~/.claude/plugins/cache/thedotmack/claude-mem/*/hooks/hooks.json", "scope": "claude-mem 插件"}
      ],
      "expected": [
        {"component": "claude-mem", "required": true},
        {"component": "kg-push", "required": true},
        {"component": "task-hub", "required": true}
      ]
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "difference": "原生 Hook · 用户/项目两级",
      "sources": [
        {"kind": "json", "path": "~/.cursor/hooks.json", "scope": "用户"},
        {"kind": "json", "path": "/Users/mac/workspace_cursor/.cursor/hooks.json", "scope": "workspace_cursor 项目"}
      ],
      "expected": [
        {"component": "claude-mem", "required": true, "scope": "user"},
        {"component": "kg-push", "required": true, "scope": "user"},
        {"component": "task-hub", "required": true}
      ]
    },
    {
      "id": "codex",
      "label": "Codex",
      "difference": "插件 Hook · 需逐项批准",
      "sources": [
        {"kind": "latest_glob", "path": "~/.codex/plugins/cache/*/claude-mem/*/hooks/codex-hooks.json", "scope": "claude-mem 插件"}
      ],
      "approval": "~/.codex/config.toml",
      "expected": [
        {"component": "claude-mem", "required": true}
      ]
    },
    {
      "id": "qoder",
      "label": "Qoder",
      "difference": "适配器 · 宿主未配置",
      "sources": [
        {"kind": "json", "path": "~/Library/Application Support/Qoder/SharedClientCache/hooks.json", "scope": "用户"},
        {"kind": "json", "path": "~/.qoder/hooks.json", "scope": "用户"}
      ],
      "expected": [
        {"component": "claude-mem", "required": false}
      ],
      "note": "有适配器，无宿主配置"
    },
    {
      "id": "deepseek-harness",
      "label": "DeepSeek Harness",
      "difference": "原生插件 · 可桥接 Claude/Codex",
      "sources": [
        {"kind": "presence", "path": "~/Library/Application Support/dsh-desktop/harness/profiles/web/package.json", "scope": "安装"},
        {"kind": "dsh_cordis", "path": "~/Library/Application Support/dsh-desktop/harness/profiles/web/cordis.patch.yml", "scope": "用户配置"}
      ],
      "expected": [
        {"component": "hook-bridge", "required": false}
      ],
      "note": "已安装，Hook Bridge 未启用"
    },
    {
      "id": "openclaw",
      "label": "OpenClaw",
      "difference": "非 IDE Hook · VPS 定时直推",
      "sources": [],
      "expected": [],
      "note": "由 cron / push.log 直推"
    }
  ]
}
